# Google Drive API v3 key used by the static client.
# Enable the Drive API, create an API key and restrict it by HTTP referrer.
VITE_GOOGLE_API_KEY=

# ── Firebase ────────────────────────────────────────────────────────────────
# Access config (staffPin, dailySalt) lives in Firestore (config/access).
# Get these values from the Firebase Console → Project Settings → Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Fallback / local dev ─────────────────────────────────────────────────────
# Used only if Firebase is unreachable. Change before publishing.
VITE_SECRET_SALT=
VITE_STAFF_PASSWORD=

# Extra 4-digit PIN for the admin controls (owner only). Never goes to Firestore.
VITE_OWNER_PASSWORD=
