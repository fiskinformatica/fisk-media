# URL of the Cloudflare Workers backend API (for catalog and admin only).
# In development: http://localhost:8787
# In production: https://fisk-media-backend.YOUR-WORKERS-SUBDOMAIN.workers.dev
VITE_API_URL=

# Google Drive API Key for direct media playback (PUBLIC KEY - client-side use)
# This key is used ONLY for direct streaming from Google Drive.
# The backend never uses this key.
VITE_GOOGLE_API_KEY=

# Legacy variables (no longer used)
# VITE_SECRET_SALT=
# VITE_STAFF_PASSWORD=
# VITE_OWNER_PASSWORD=
