# Google Drive API v3 key used by the static client.
# Enable the Drive API, create an API key and restrict it by HTTP referrer.
VITE_GOOGLE_API_KEY=

# Secret used to generate the monthly student PIN.
# Change it before publishing. Never reuse the example value.
VITE_SECRET_SALT=

# 4-digit PIN used to open the teacher area.
# Change it before publishing.
VITE_STAFF_PASSWORD=

# Extra 4-digit PIN for the admin controls (sync and folder ordering).
# Keep it different from VITE_STAFF_PASSWORD.
VITE_OWNER_PASSWORD=
