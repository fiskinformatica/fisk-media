# Backend - Fisk Media API
# Cloudflare Workers + Hono + D1

# Google Drive API key (public shared folders - restrict by HTTP referrer)
GOOGLE_API_KEY=

# JWT secret for admin authentication (generate with: openssl rand -hex 32)
JWT_SECRET=

# Secret salt for monthly PIN generation (must match VITE_SECRET_SALT in frontend)
SECRET_SALT=

# Admin setup key (used once to create the first admin account)
ADMIN_SETUP_KEY=

# Frontend URL for CORS (set in wrangler.toml per-environment, not needed here)
# FRONTEND_URL=https://fiskinformatica.github.io
